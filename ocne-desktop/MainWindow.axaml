<Window
  x:Class="OCNE.Desktop.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:web="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
  Title="OCNE Desktop"
  Width="1280"
  Height="820"
  MinWidth="960"
  MinHeight="640"
  Background="#070A12">
  <Grid RowDefinitions="48,*">
    <Border Grid.Row="0" Background="#0D1220" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="8" Background="#22D3EE">
            <TextBlock Text="O" Foreground="#020617" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="OCNE Desktop" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox
          x:Name="AddressBox"
          Grid.Column="1"
          Margin="18,7"
          Text="https://ocne.onrender.com/"
          Background="#111827"
          Foreground="#E5E7EB"
          BorderBrush="#334155"
          CornerRadius="8"
          PlaceholderText="Website URL" />

        <Button Grid.Column="2" Margin="4,7" Padding="14,0" Click="GoButton_Click">Go</Button>
        <Button Grid.Column="3" Margin="4,7" Padding="14,0" Click="ReloadButton_Click">Reload</Button>
        <Button Grid.Column="4" Margin="4,7" Padding="14,0" Click="HomeButton_Click">Home</Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <web:NativeWebView x:Name="Browser" Source="https://ocne.onrender.com/" />
      <Border
        x:Name="StatusPanel"
        IsVisible="False"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,18,0,0"
        Padding="14,8"
        CornerRadius="10"
        Background="#111827"
        BorderBrush="#334155"
        BorderThickness="1">
        <TextBlock x:Name="StatusText" Foreground="#BAE6FD" />
      </Border>
    </Grid>
  </Grid>
</Window>
